#############################################
# Create library symlink external\assimp\bin\libassimp.so

build external/assimp/bin/libassimp.so.6 external/assimp/bin/libassimp.so: CMAKE_SYMLINK_LIBRARY external/assimp/bin/libassimp.so.6.0.5
  POST_BUILD = cd .


#############################################
# Utility command for edit_cache

build external/assimp/code/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Github\GameEngine\GameEngine\GameEngine\build-web\external\assimp\code && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\Github\GameEngine\GameEngine\GameEngine -BC:\Github\GameEngine\GameEngine\GameEngine\build-web"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build external/assimp/code/edit_cache: phony external/assimp/code/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build external/assimp/code/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Github\GameEngine\GameEngine\GameEngine\build-web\external\assimp\code && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Github\GameEngine\GameEngine\GameEngine -BC:\Github\GameEngine\GameEngine\GameEngine\build-web"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build external/assimp/code/rebuild_cache: phony external/assimp/code/CMakeFiles/rebuild_cache.util

